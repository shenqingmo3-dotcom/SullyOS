# Collar_watch repository and persistent private data directory.
HEALTH_COLLAR_ROOT=C:\path\to\Collar_watch
HEALTH_DATA_DIR=C:\path\to\private-health-data

# Collar_watch currently uses a fixed UTC offset, not an IANA timezone.
# New Zealand: 12 in standard time, 13 in daylight saving time.
HEALTH_TZ_OFFSET_HOURS=12

# Use two different random values, each at least 24 characters.
HEALTH_INGEST_TOKEN=replace-with-a-long-random-ingest-token
MCP_ACCESS_TOKEN=replace-with-a-different-long-random-mcp-token

# Network defaults. Keep 127.0.0.1 and put HTTPS in front of it.
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8766
MCP_ALLOW_ORIGIN=*
